PORT=5000
NODE_ENV=development

# Core app configuration
MONGODB_URI=mongodb://localhost:27017/quickhireai
JWT_SECRET=replace_with_a_long_secure_random_string
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Code execution configuration
CODE_EXECUTION_ENABLED=true
CODE_EXECUTION_PROVIDER=judge0
CODE_EXECUTION_FALLBACK_PROVIDER=onecompiler
CODE_MAX_SOURCE_LENGTH=50000
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=replace_if_needed
JUDGE0_HOST=localhost
ONECOMPILER_API_URL=https://api.onecompiler.com/v1/run
ONECOMPILER_API_KEY=replace_with_your_onecompiler_key

# Cloudinary / media uploads
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# SMTP / email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=replace_with_app_password
SMTP_FROM="QuickHire AI" <no-reply@example.com>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=replace_with_app_password
EMAIL_FROM="QuickHire AI" <no-reply@example.com>
